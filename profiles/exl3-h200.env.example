# Baseline measured 2026-09-22 on 2x H200. Edit paths/resources for the NEXT host.
# Shell profile: trusted code. No tokens. Install pinned EXL3 adapter first.
ENGINE=vllm
ROOT=/srv/ds41-exl3
PYTHON_BIN=$ROOT/venv/bin/python
MODEL_PATH=$ROOT/model
ENGRAM_PATH=$ROOT/engram
MODEL_ID=deepseek-v4.1-flash
HOST=127.0.0.1
PORT=18080
TP=2
MAX_MODEL_LEN=65536
MAX_NUM_SEQS=1
MAX_BATCHED_TOKENS=2048
GPU_MEMORY=0.90
EAGER=1
QUANTIZATION=exl3
TOKENIZER_MODE=deepseek_v41
REASONING_PARSER=deepseek_v41
TOOL_PARSER=deepseek_v41
TRUST_REMOTE_CODE=1
# Must match OVERLAY_DIR used by deploy/install-runtime.sh.
export PYTHONPATH=$ROOT/overlay
export CUDA_HOME=/usr/local/cuda
export PATH=$ROOT/venv/bin:$CUDA_HOME/bin:$PATH
export HF_HOME=$ROOT/cache/hf
export XDG_CACHE_HOME=$ROOT/cache
export TORCH_EXTENSIONS_DIR=$ROOT/cache/torch_extensions
export VLLM_CACHE_ROOT=$ROOT/cache/vllm
# Required with the actual serial-stream source patch, not a substitute for it.
export DSV41_EXL3_SERIAL_STREAMS=1
export VLLM_DISABLE_SHARED_EXPERTS_STREAM=1
export EXL3_FAT_GROUPED=0
export DSV41_CACHE_GIB=8  # total host row-store budget; /2 layers /2 ranks -> 2 GiB each
export DSV41_IO_THREADS=16
# H200/Vast baseline, not universal CUDA requirements.
export NCCL_NVLS_ENABLE=0
export NCCL_CUMEM_ENABLE=0
export NCCL_IB_DISABLE=1
export VLLM_ALLREDUCE_USE_FLASHINFER=0
export VLLM_ALLREDUCE_USE_SYMM_MEM=0
export VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
EXTRA_ARGS=(--disable-custom-all-reduce)
# Fast path after the baseline smoke (docs/13-speed.md). Measured ~58 tok/s on 4x H100;
# NOT yet measured on H200 — enable at rehearsal, one step per restart.
# Needs deploy/patch-fast-path.py (EXL3 pretune), applied by install-runtime.sh.
# EAGER=0
# EXTRA_ARGS+=(--cudagraph-capture-sizes 1 2 3 4 6 8 12 18 24)
# EXTRA_ARGS+=(--speculative-config '{"method":"dspark","num_speculative_tokens":3}')

# Staged deployment runner. These pins are for this checkpoint, not generic EXL3.
MODEL_REPO=dealignai/DeepSeek-V4.1-Flash-UNCENSORED-EXL3-2.9bpw
# Build-only setting; verify for the actual GPU. Tested baseline: H200.
export TORCH_CUDA_ARCH_LIST=9.0a
# Set UV_BIN to the actual executable if it is not on PATH.
# export UV_BIN=/opt/sglang/bin/uv
