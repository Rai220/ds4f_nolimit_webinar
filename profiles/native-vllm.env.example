# Skeleton for a NEW BF16/FP16/native checkpoint. NOT a sized DeepSeek recipe.
# Fill these deliberately after checking model config, engine support and GPU budget.
ENGINE=vllm
PYTHON_BIN=/srv/new-model/venv/bin/python
MODEL_PATH=/srv/new-model/model
MODEL_ID=REPLACE_WITH_SERVED_MODEL_ID
TP=REPLACE_WITH_VALID_TP
MAX_MODEL_LEN=REPLACE_WITH_INITIAL_CONTEXT
HOST=127.0.0.1
PORT=18080
MAX_NUM_SEQS=1
MAX_BATCHED_TOKENS=2048
GPU_MEMORY=0.85
EAGER=1
QUANTIZATION=
# Leave auto tokenizer for a generic model; use actual architecture-specific parsers.
TOKENIZER_MODE=
REASONING_PARSER=
TOOL_PARSER=
TRUST_REMOTE_CODE=0
EXTRA_ARGS=()
