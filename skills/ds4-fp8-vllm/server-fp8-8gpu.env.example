# Ready profile for 8x H100 80GB: all eight GPUs, TP=8 + EP, CUDA graphs, DSpark k=3, 32 sequences,
# full 1M window. Measured 2026-09-24 (reports/2026-09-24/fp8/bench-20260924-fp8-tp8-dspark-seq32-1m):
# 201-214 tok/s single stream, 711 at 4, 1152 at 8, 1806 at 16, 2697 at 32 (1024 tokens, temperature 0).
# ops/long-context.py found a hidden code at 130k, 521k and 1,033,152 prompt tokens; prefill took
# 12.6 s, 68.7 s and 252.8 s.
# Its command is pinned by tests/test_portable.py. Change only ROOT and PORT.
ENGINE=vllm
ROOT=/var/tmp/ds41-fp8
PYTHON_BIN=$ROOT/venv/bin/python
MODEL_PATH=$ROOT/model
# No ENGRAM_PATH: Engram tables are inside this snapshot; vLLM keeps them in pinned RAM.
MODEL_ID=deepseek-v4.1-flash
HOST=127.0.0.1
PORT=18080
# 64 attention heads and o_groups=8 split into 8 ranks; experts 48 of 384 per GPU.
# Weights 37.6 GiB per GPU. No data parallel: stock vLLM 0.30.0
# mis-routes DSv4 hash experts under DP (see [dsv41-dp-input-ids] in docs/13).
TP=8
# max_position_embeddings (YaRN x16 from the native 65536). KV cache 17.7M tokens = 16.8 full-window
# requests. Versus 65536: decode at 1-16 streams within run-to-run spread, at 32 streams 5% lower
# (2697 vs 2852 tok/s). Lower the window only if that 5% matters more than long prompts.
MAX_MODEL_LEN=1048576
# Each sequence yields 4 tokens per step with k=3: 32 sequences -> graph size 128.
MAX_NUM_SEQS=32
MAX_BATCHED_TOKENS=1024
GPU_MEMORY=0.97
EAGER=0
TOKENIZER_MODE=deepseek_v41
REASONING_PARSER=deepseek_v41
TOOL_PARSER=deepseek_v41
TRUST_REMOTE_CODE=1
# Toolkit from scripts/install-cuda-toolkit.sh: nvcc and headers of one CUDA version (see SKILL.md).
export CUDA_HOME=$ROOT/cuda13/nvidia/cu13
export PATH=$ROOT/venv/bin:$CUDA_HOME/bin:$PATH
export CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
export TMPDIR=$ROOT/cache/tmp
export HF_HOME=$ROOT/cache/hf
export XDG_CACHE_HOME=$ROOT/cache
export TORCH_EXTENSIONS_DIR=$ROOT/cache/torch_extensions
export VLLM_CACHE_ROOT=$ROOT/cache/vllm
# JIT caches stay on the local disk, never in a shared $HOME.
export FLASHINFER_WORKSPACE_BASE=$ROOT/cache
export TRITON_CACHE_DIR=$ROOT/cache/triton
export TILELANG_CACHE_DIR=$ROOT/cache/tilelang
export CUDA_CACHE_PATH=$ROOT/cache/nv
export VLLM_NO_USAGE_STATS=1
export NCCL_NVLS_ENABLE=0
export VLLM_ALLREDUCE_USE_FLASHINFER=0
export VLLM_ALLREDUCE_USE_SYMM_MEM=0
export VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
export TORCH_CUDA_ARCH_LIST=9.0a
EXTRA_ARGS=(--disable-custom-all-reduce --enable-expert-parallel --language-model-only
  --cudagraph-capture-sizes 1 2 3 4 6 8 12 16 24 32 48 64 96 128
  --speculative-config '{"method":"dspark","num_speculative_tokens":3}')
MODEL_REPO=dealignai/DeepSeek-V4.1-Flash-UNCENSORED-FP8
