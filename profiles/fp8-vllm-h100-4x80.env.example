# Measured 2026-09-23 on 4x H100 80GB: ~206 tok/s single stream, 644 tok/s at 4 streams.
# dealignai FP8 checkpoint (FP8 block linears + MXFP4 experts), STOCK vLLM 0.30.0.
# Separate venv: no EXL3 overlay/patches (they replace Engram). Details: docs/13-speed.md.
# Fill ROOT and CUDA_HOME from inventory. No tokens, no rental addresses.
# Ready, verified-from-scratch variant with toolkit and cache settings: skills/ds4-fp8-vllm/.
# CUDA_HOME must hold nvcc and headers of one version (not the venv's nvidia/cu13).
ENGINE=vllm
ROOT=/PATH/ON/LOCAL/OVERLAY/ds41-fp8
PYTHON_BIN=$ROOT/venv/bin/python
MODEL_PATH=$ROOT/model
# No ENGRAM_PATH: Engram tables are inside this snapshot; vLLM keeps them in pinned RAM
# (EngramConfig cpu_offload=True by default): 23.6 GiB per rank per layer, 189 GiB total.
MODEL_ID=deepseek-v4.1-flash
HOST=127.0.0.1
PORT=18080
# Weights are 73.4 GiB per GPU with DSpark (71.2 without); TP=4 + EP is the tightest packing.
TP=4
# KV left 1.68 GiB per GPU = 639,692 tokens; 1048576 does not fit with DSpark.
MAX_MODEL_LEN=65536
MAX_NUM_SEQS=4
MAX_BATCHED_TOKENS=1024
GPU_MEMORY=0.97
EAGER=0
TOKENIZER_MODE=deepseek_v41
REASONING_PARSER=deepseek_v41
TOOL_PARSER=deepseek_v41
TRUST_REMOTE_CODE=1
export CUDA_HOME=/PATH/TO/CUDA13
export PATH=$ROOT/venv/bin:$CUDA_HOME/bin:$PATH
export HF_HOME=$ROOT/cache/hf
export XDG_CACHE_HOME=$ROOT/cache
export TORCH_EXTENSIONS_DIR=$ROOT/cache/torch_extensions
export VLLM_CACHE_ROOT=$ROOT/cache/vllm
export VLLM_NO_USAGE_STATS=1
export NCCL_NVLS_ENABLE=0
export VLLM_ALLREDUCE_USE_FLASHINFER=0
export VLLM_ALLREDUCE_USE_SYMM_MEM=0
export VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
export TORCH_CUDA_ARCH_LIST=9.0a
# --language-model-only drops the 0.9 GiB vision tower: no image input on this profile.
EXTRA_ARGS=(--disable-custom-all-reduce --enable-expert-parallel --language-model-only
  --cudagraph-capture-sizes 1 2 3 4 6 8 12 16
  --speculative-config '{"method":"dspark","num_speculative_tokens":3}')
# Fallbacks, one restart each: drop --speculative-config and set GPU_MEMORY=0.95 (~109 tok/s,
# KV 940k tokens); then EAGER=1 (baseline, ~11.5 tok/s).
MODEL_REPO=dealignai/DeepSeek-V4.1-Flash-UNCENSORED-FP8
