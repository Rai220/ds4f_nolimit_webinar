# Only on a real systemd host, not an unprivileged Vast container.
# Replace User, WorkingDirectory, ExecStart, and paths. Compare with local host rules.
[Unit]
Description=Model inference API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_SERVICE_USER
WorkingDirectory=/ABS/bundle
ExecStart=/ABS/bundle/ops/run-model.sh /ABS/profile.env
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
