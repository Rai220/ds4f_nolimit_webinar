# Starting template based on historical 8xH100 source deployment.
# This portable launcher/profile combination has NOT been run on a fresh GPU host.
ENGINE=sglang
ROOT=/srv/ds41-fp8
PYTHON_BIN=$ROOT/venv/bin/python
MODEL_PATH=$ROOT/model
MODEL_ID=deepseek-v4.1-flash
HOST=127.0.0.1
PORT=30000
TP=8
EP=8
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=1
MAX_BATCHED_TOKENS=2048
GPU_MEMORY=0.80
EAGER=1
# Use checkpoint quantization metadata; don't force EXL3 or convert by renaming.
QUANTIZATION=
REASONING_PARSER=deepseek-v41
TOOL_PARSER=deepseekv41
TRUST_REMOTE_CODE=1
export SGLANG_ENABLE_DSV41_ENGRAM_HOST_TABLE=1
export SGLANG_DSV41_ENGRAM_HOST_TABLE_LAYOUT=private
export SGLANG_DEFAULT_THINKING=true
export SGLANG_DSV41_REASONING_EFFORT=high
export XDG_CACHE_HOME=$ROOT/cache/xdg
export SGLANG_CACHE_DIR=$ROOT/cache/sglang
export TILELANG_CACHE_DIR=$ROOT/cache/tilelang
export FLASHINFER_WORKSPACE_BASE=$ROOT/cache/flashinfer
EXTRA_ARGS=()
