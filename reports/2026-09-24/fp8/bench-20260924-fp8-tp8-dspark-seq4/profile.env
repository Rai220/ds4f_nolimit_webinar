# Ready profile: dealignai DeepSeek V4.1 Flash UNCENSORED FP8 on stock vLLM 0.30.0, 4x H100 80GB.
# Reproduces the measured command in reports/2026-09-23/fp8/serve-command.txt byte for byte.
# Works as is after the SKILL.md install/download steps with ROOT=/var/tmp/ds41-fp8.
# Change only: ROOT (local disk, see df), CUDA_VISIBLE_DEVICES (4 free GPUs), PORT if busy.
# Any other change is a different experiment: give its bench report its own name.
ENGINE=vllm
ROOT=/var/tmp/ds41-fp8
PYTHON_BIN=$ROOT/venv/bin/python
MODEL_PATH=$ROOT/model
# No ENGRAM_PATH: Engram tables are inside this snapshot; vLLM keeps them in pinned RAM
# (189 GiB total, 23.6 GiB per rank per layer), so the node needs >=256 GB RAM.
MODEL_ID=deepseek-v4.1-flash
HOST=127.0.0.1
PORT=18080
# Weights 73.4 GiB per GPU with DSpark; TP=4 + EP is the tightest packing on 80 GB cards.
TP=8
# KV left 1.68 GiB per GPU = 639,692 tokens; 1048576 does not fit with DSpark.
MAX_MODEL_LEN=65536
MAX_NUM_SEQS=4
MAX_BATCHED_TOKENS=1024
GPU_MEMORY=0.97
EAGER=0
TOKENIZER_MODE=deepseek_v41
REASONING_PARSER=deepseek_v41
TOOL_PARSER=deepseek_v41
TRUST_REMOTE_CODE=1
# DeepGEMM and FlashInfer JIT-compile with $CUDA_HOME/bin/nvcc; CCCL requires nvcc major.minor to equal
# the headers' CUDART_VERSION. The venv's own nvidia/cu13 mixes nvcc 13.4 with 13.0 headers and fails:
# "CUDA compiler and CUDA toolkit headers are incompatible". Use the toolkit from
# scripts/install-cuda-toolkit.sh (or a consistent system CUDA 13.x with curand/cublas headers).
export CUDA_HOME=$ROOT/cuda13/nvidia/cu13
export PATH=$ROOT/venv/bin:$CUDA_HOME/bin:$PATH
# Exactly 4 GPUs for TP=4. On an 8-GPU node the other four stay free.
export CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
export TMPDIR=$ROOT/cache/tmp
export HF_HOME=$ROOT/cache/hf
export XDG_CACHE_HOME=$ROOT/cache
export TORCH_EXTENSIONS_DIR=$ROOT/cache/torch_extensions
export VLLM_CACHE_ROOT=$ROOT/cache/vllm
# JIT caches default to $HOME, which on shared notebooks is one NFS home for several nodes with
# different toolkits: a node rebuilt another node's FlashInfer module there. Keep them local.
export FLASHINFER_WORKSPACE_BASE=$ROOT/cache
export TRITON_CACHE_DIR=$ROOT/cache/triton
export TILELANG_CACHE_DIR=$ROOT/cache/tilelang
export CUDA_CACHE_PATH=$ROOT/cache/nv
export VLLM_NO_USAGE_STATS=1
export NCCL_NVLS_ENABLE=0
export VLLM_ALLREDUCE_USE_FLASHINFER=0
export VLLM_ALLREDUCE_USE_SYMM_MEM=0
export VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
export TORCH_CUDA_ARCH_LIST=9.0a
# --language-model-only drops the vision tower: no image input on this profile.
EXTRA_ARGS=(--disable-custom-all-reduce --enable-expert-parallel --language-model-only
  --cudagraph-capture-sizes 1 2 3 4 6 8 12 16
  --speculative-config '{"method":"dspark","num_speculative_tokens":3}')
# Fallbacks, one restart each, each a separately named measurement:
# 1) drop --speculative-config, GPU_MEMORY=0.95 (~109 tok/s); 2) also EAGER=1 (~11.5 tok/s).
MODEL_REPO=dealignai/DeepSeek-V4.1-Flash-UNCENSORED-FP8
