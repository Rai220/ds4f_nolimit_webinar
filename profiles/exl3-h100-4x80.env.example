# Measured 2026-09-23 on 4x H100 80GB: ~58 tok/s single stream, 254 tok/s at 8 streams.
# Fill ROOT and CUDA_HOME from inventory. No tokens, no rental addresses.
# Procedure: docs/12-h100-4x80.md, speed notes: docs/13-speed.md.
# Requires deploy/patch-fast-path.py (install-runtime.sh applies it).
# Do not run ops/exl3.sh preflight on this host.
ENGINE=vllm
ROOT=/PATH/ON/LOCAL/OVERLAY/ds41-exl3
PYTHON_BIN=$ROOT/venv/bin/python
MODEL_PATH=$ROOT/model
ENGRAM_PATH=$ROOT/engram
MODEL_ID=deepseek-v4.1-flash
HOST=127.0.0.1
PORT=18080
# TP stays 2: moe_intermediate 2304/TP must be divisible by 128, TP=4 fails.
# Four GPUs come from DP=2 + expert parallel (EXTRA_ARGS): ~50.5 GiB weights per GPU, no offload.
TP=2
MAX_MODEL_LEN=1048576
# Per DP replica: 2 replicas x 4 = 8 concurrent requests.
MAX_NUM_SEQS=4
MAX_BATCHED_TOKENS=2048
# Left 12.2 GiB KV per replica with graphs + DSpark.
GPU_MEMORY=0.90
# CUDA graphs: eager was CPU-bound (11 tok/s vs 35 with graphs).
EAGER=0
QUANTIZATION=exl3
TOKENIZER_MODE=deepseek_v41
REASONING_PARSER=deepseek_v41
TOOL_PARSER=deepseek_v41
TRUST_REMOTE_CODE=1
export PYTHONPATH=$ROOT/overlay
export CUDA_HOME=/PATH/TO/CUDA13
export PATH=$ROOT/venv/bin:$CUDA_HOME/bin:$PATH
export HF_HOME=$ROOT/cache/hf
export XDG_CACHE_HOME=$ROOT/cache
export TORCH_EXTENSIONS_DIR=$ROOT/cache/torch_extensions
export VLLM_CACHE_ROOT=$ROOT/cache/vllm
export VLLM_NO_USAGE_STATS=1
export DSV41_EXL3_SERIAL_STREAMS=1
export VLLM_DISABLE_SHARED_EXPERTS_STREAM=1
export EXL3_FAT_GROUPED=0
export DSV41_CACHE_GIB=8
export DSV41_IO_THREADS=16
export NCCL_NVLS_ENABLE=0
export VLLM_ALLREDUCE_USE_FLASHINFER=0
export VLLM_ALLREDUCE_USE_SYMM_MEM=0
export VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
# DP>1 gathers router rows across replicas; the local padding mask then mismatches
# in the DSpark draft router (is_padding size mismatch).
export VLLM_MOE_SKIP_PADDING=0
EXTRA_ARGS=(--disable-custom-all-reduce
  --data-parallel-size 2 --enable-expert-parallel
  --cudagraph-capture-sizes 1 2 3 4 6 8 12 18 24
  --speculative-config '{"method":"dspark","num_speculative_tokens":3}')
# Fallbacks, one restart each: drop --speculative-config (graphs only, ~35 tok/s);
# then EAGER=1 (baseline). On 2x H100: remove DP/EP args, add --cpu-offload-gb 32,
# GPU_MEMORY=0.95, MAX_NUM_SEQS=1, EAGER=1 (measured 9.6 tok/s).
MODEL_REPO=dealignai/DeepSeek-V4.1-Flash-UNCENSORED-EXL3-2.9bpw
# H100 is Hopper. 9.0a matched the tested H200 cubins and ran here.
export TORCH_CUDA_ARCH_LIST=9.0a
# export UV_BIN=/actual/uv
